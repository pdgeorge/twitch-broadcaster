# Twitch credentials
CLIENT_ID=your_twitch_client_id
CLIENT_SECRET=your_twitch_client_secret
REFRESH_TOKEN=your_initial_refresh_token
CHANNEL_ID=your_broadcaster_channel_id

# Optional overrides
RABBITMQ_URL=amqp://guest:guest@twitch_broadcaster:5672/
TOKEN_CACHE_PATH=/data/tokens.json
RABBITMQ_EXCHANGE=twitch_events
OVERLAY_HTTP_PORT=8080
OVERLAY_QUEUE=overlay_chat

# Optional: make the /admin page ask for this password (any username)
# ADMIN_PASSWORD=

# Dabi's shop: !openshop switches OBS to the shop's scene and plays its music
# through pd-streamdeck. DECK_TOKEN is the same token as in pd-streamdeck's .env.
# DECK_TOKEN=
# DECK_URL=http://pd-streamdeck:8095
# SHOP_SCENE=Dabi-Shop
# SHOP_MOOD=shop
